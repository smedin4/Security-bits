    {
      "type": "Microsoft.DataFactory/factories/dataflows",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'df_json_to_delta')]",
      "properties": {
        "type": "MappingDataFlow",
        "description": "Generic JSON-lines to Delta conversion with schema drift. Validate in a Data Factory Studio debug session before relying on it in production.",
        "annotations": [
          "sentinel-bcdr",
          "delta"
        ],
        "typeProperties": {
          "sources": [
            {
              "name": "SourceJson",
              "linkedService": {
                "referenceName": "ls_source_monitor_export_blob",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "sinks": [
            {
              "name": "DeltaSink",
              "linkedService": {
                "referenceName": "ls_target_bcdr_adlsgen2",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "transformations": [
            {
              "name": "AddMeta"
            }
          ],
          "scriptLines": [
            "parameters{",
            "\tcontainerName as string,",
            "\tsourceFolderPath as string,",
            "\tsourceFilePattern as string,",
            "\ttargetFileSystem as string,",
            "\ttargetFolder as string",
            "}",
            "source(allowSchemaDrift: true,",
            "\tvalidateSchema: false,",
            "\tinferDriftedColumnTypes: false,",
            "\tignoreNoFilesFound: true,",
            "\tformat: 'json',",
            "\tcontainer: ($containerName),",
            "\twildcardPaths: [(concat($sourceFolderPath, '/**/', $sourceFilePattern))],",
            "\tdocumentForm: 'documentPerLine') ~> SourceJson",
            "SourceJson derive(IngestedUtc = currentUTC()) ~> AddMeta",
            "AddMeta sink(allowSchemaDrift: true,",
            "\tvalidateSchema: false,",
            "\tformat: 'delta',",
            "\tfileSystem: ($targetFileSystem),",
            "\tfolderPath: ($targetFolder),",
            "\tmergeSchema: true,",
            "\tautoCompact: true,",
            "\toptimizeWrite: true,",
            "\tinsertable: true,",
            "\tupdateable: false,",
            "\tdeletable: false,",
            "\tupsertable: false,",
            "\tskipDuplicateMapInputs: true,",
            "\tskipDuplicateMapOutputs: true) ~> DeltaSink"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', parameters('dataFactoryName'), 'ls_source_monitor_export_blob')]",
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', parameters('dataFactoryName'), 'ls_target_bcdr_adlsgen2')]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/dataflows",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'df_build_schemas')]",
      "properties": {
        "type": "MappingDataFlow",
        "description": "Read the raw Log Analytics Tables API dump (_raw/workspace-tables.json) and emit a compact per-table column-type map (_schemas/workspace-schemas.json) used by the export to cast string columns back to native types. Isolated from the export path: only pl_refresh_table_schemas references it. Validate in a Data Factory Studio debug session (confirm the single-file JSON sink option and data preview) before relying on the output.",
        "annotations": [
          "sentinel-bcdr",
          "metadata"
        ],
        "typeProperties": {
          "sources": [
            {
              "name": "RawSchemas",
              "linkedService": {
                "referenceName": "ls_target_bcdr_adlsgen2",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "sinks": [
            {
              "name": "SchemasSink",
              "linkedService": {
                "referenceName": "ls_target_bcdr_adlsgen2",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "transformations": [
            {
              "name": "FlattenCols"
            },
            {
              "name": "Bucket"
            },
            {
              "name": "Bucketed"
            }
          ],
          "scriptLines": [
            "parameters{",
            "\tmetadataFileSystem as string",
            "}",
            "source(output(",
            "\t\tvalue as (properties as (schema as (name as string, standardColumns as (name as string, type as string)[])))[]",
            "\t),",
            "\tallowSchemaDrift: true,",
            "\tvalidateSchema: false,",
            "\tignoreNoFilesFound: false,",
            "\tformat: 'json',",
            "\tfileSystem: ($metadataFileSystem),",
            "\tfolderPath: '_raw',",
            "\tfileName: 'workspace-tables.json',",
            "\tdocumentForm: 'singleDocument') ~> RawSchemas",
            "RawSchemas foldDown(unroll(value.properties.schema.standardColumns, value),",
            "\tmapColumn(",
            "\t\ttableName = value.properties.schema.name,",
            "\t\tcolName = value.properties.schema.standardColumns.name,",
            "\t\tlaType = value.properties.schema.standardColumns.type",
            "\t),",
            "\tskipDuplicateMapInputs: true,",
            "\tskipDuplicateMapOutputs: true) ~> FlattenCols",
            "FlattenCols derive(tableKey = lower(tableName),",
            "\t\tbkt = case(laType == 'int' || laType == 'long', 'long', laType == 'real', 'double', laType == 'boolean', 'boolean', laType == 'datetime', 'timestamp', 'string')) ~> Bucket",
            "Bucket aggregate(groupBy(tableKey),",
            "\tlongCols = collect(case(bkt == 'long', colName)),",
            "\tdoubleCols = collect(case(bkt == 'double', colName)),",
            "\tboolCols = collect(case(bkt == 'boolean', colName)),",
            "\ttsCols = collect(case(bkt == 'timestamp', colName))) ~> Bucketed",
            "Bucketed sink(allowSchemaDrift: true,",
            "\tvalidateSchema: false,",
            "\tformat: 'json',",
            "\tfileSystem: ($metadataFileSystem),",
            "\tfolderPath: '_schemas',",
            "\tpartitionFileNames: ['workspace-schemas.json'],",
            "\tskipDuplicateMapInputs: true,",
            "\tskipDuplicateMapOutputs: true,",
            "\tpartitionBy('roundRobin', 1)) ~> SchemasSink"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', parameters('dataFactoryName'), 'ls_target_bcdr_adlsgen2')]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'pl_export_container_window_delta')]",
      "properties": {
        "description": "Export one Azure Monitor container/window to a Delta table using the df_json_to_delta Mapping Data Flow. Opt-in alternative to the Parquet copy pipeline; validate in Studio before scheduling.",
        "parameters": {
          "containerName": {
            "type": "String"
          },
          "modifiedAfterUtc": {
            "type": "String"
          },
          "modifiedBeforeUtc": {
            "type": "String"
          },
          "sourceFolderPath": {
            "type": "String",
            "defaultValue": "WorkspaceResourceId=*"
          },
          "sourceFilePattern": {
            "type": "String",
            "defaultValue": "PT5M*.json"
          },
          "sourceWorkspaceResourceId": {
            "type": "String",
            "defaultValue": ""
          },
          "targetFileSystem": {
            "type": "String",
            "defaultValue": "sentinel-bcdr"
          },
          "sourceContainerPrefix": {
            "type": "String",
            "defaultValue": "am-"
          },
          "dataFlowDebugLogging": {
            "type": "Bool",
            "defaultValue": false
          }
        },
        "activities": [
          {
            "name": "WriteDeltaTable",
            "type": "ExecuteDataFlow",
            "dependsOn": [],
            "policy": {
              "timeout": "7.00:00:00",
              "retry": 1,
              "retryIntervalInSeconds": 120,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "dataflow": {
                "referenceName": "df_json_to_delta",
                "type": "DataFlowReference",
                "parameters": {
                  "containerName": "'@{pipeline().parameters.containerName}'",
                  "sourceFolderPath": "'@{if(empty(pipeline().parameters.sourceWorkspaceResourceId), pipeline().parameters.sourceFolderPath, concat('WorkspaceResourceId=', pipeline().parameters.sourceWorkspaceResourceId, '/y=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'yyyy'), '/m=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'MM'), '/d=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'dd'), '/h=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'HH')))}'",
                  "sourceFilePattern": "'@{pipeline().parameters.sourceFilePattern}'",
                  "targetFileSystem": "'@{pipeline().parameters.targetFileSystem}'",
                  "targetFolder": "'@{if(and(not(empty(pipeline().parameters.sourceContainerPrefix)), startswith(toLower(pipeline().parameters.containerName), toLower(pipeline().parameters.sourceContainerPrefix))), substring(pipeline().parameters.containerName, length(pipeline().parameters.sourceContainerPrefix), sub(length(pipeline().parameters.containerName), length(pipeline().parameters.sourceContainerPrefix))), pipeline().parameters.containerName)}'"
                }
              },
              "integrationRuntime": {
                "referenceName": "ir-dataflow-warm",
                "type": "IntegrationRuntimeReference"
              },
              "traceLevel": "@if(pipeline().parameters.dataFlowDebugLogging, 'Fine', 'None')"
            }
          }
        ],
        "annotations": [
          "sentinel-bcdr",
          "delta"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/dataflows', parameters('dataFactoryName'), 'df_json_to_delta')]",
        "[resourceId('Microsoft.DataFactory/factories/integrationRuntimes', parameters('dataFactoryName'), 'ir-dataflow-warm')]"
      ]
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'pl_discover_and_export_azmon_to_delta')]",
      "properties": {
        "description": "Discover matching Azure Monitor export containers through Azure Resource Manager and export the previous processing window to Delta tables using the df_json_to_delta data flow.",
        "parameters": {
          "sourceStorageAccountResourceId": {
            "type": "String",
            "defaultValue": "[parameters('sourceStorageAccountResourceId')]"
          },
          "sourceContainerPrefix": {
            "type": "String",
            "defaultValue": "[parameters('sourceContainerPrefix')]"
          },
          "processingDelayHours": {
            "type": "Int",
            "defaultValue": "[parameters('processingDelayHours')]"
          },
          "modifiedAfterUtc": {
            "type": "String",
            "defaultValue": ""
          },
          "modifiedBeforeUtc": {
            "type": "String",
            "defaultValue": ""
          },
          "sourceFolderPath": {
            "type": "String",
            "defaultValue": "[parameters('sourceWildcardFolderPath')]"
          },
          "sourceFilePattern": {
            "type": "String",
            "defaultValue": "[parameters('sourceFilePattern')]"
          },
          "sourceWorkspaceResourceId": {
            "type": "String",
            "defaultValue": "[parameters('sourceWorkspaceResourceId')]"
          },
          "targetFileSystem": {
            "type": "String",
            "defaultValue": "[parameters('targetFileSystem')]"
          },
          "tableAllowList": {
            "type": "String",
            "defaultValue": "[parameters('tableAllowList')]"
          }
        },
        "activities": [
          {
            "name": "ListSourceContainers",
            "type": "WebActivity",
            "dependsOn": [],
            "policy": {
              "timeout": "0.00:02:00",
              "retry": 2,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "method": "GET",
              "url": "@concat('https://management.azure.com', pipeline().parameters.sourceStorageAccountResourceId, '/blobServices/default/containers?api-version=2023-01-01')",
              "authentication": {
                "type": "MSI",
                "resource": "https://management.azure.com/"
              }
            }
          },
          {
            "name": "FilterMatchingContainers",
            "type": "Filter",
            "dependsOn": [
              {
                "activity": "ListSourceContainers",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "items": "@activity('ListSourceContainers').output.value",
              "condition": "@and(startswith(item().name, pipeline().parameters.sourceContainerPrefix), or(empty(pipeline().parameters.tableAllowList), contains(split(replace(pipeline().parameters.tableAllowList, ' ', ''), ','), item().name)))"
            }
          },
          {
            "name": "ForEachMatchingContainer",
            "type": "ForEach",
            "dependsOn": [
              {
                "activity": "FilterMatchingContainers",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "items": "@activity('FilterMatchingContainers').output.value",
              "isSequential": false,
              "batchCount": 4,
              "activities": [
                {
                  "name": "ExportContainerWindowDelta",
                  "type": "ExecutePipeline",
                  "dependsOn": [],
                  "typeProperties": {
                    "pipeline": {
                      "referenceName": "pl_export_container_window_delta",
                      "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                      "containerName": "@item().name",
                      "modifiedAfterUtc": "@if(equals(pipeline().parameters.modifiedAfterUtc, ''), formatDateTime(addHours(utcNow(), mul(-1, add(pipeline().parameters.processingDelayHours, 1))), 'yyyy-MM-ddTHH:00:00Z'), pipeline().parameters.modifiedAfterUtc)",
                      "modifiedBeforeUtc": "@if(equals(pipeline().parameters.modifiedBeforeUtc, ''), formatDateTime(addHours(utcNow(), mul(-1, pipeline().parameters.processingDelayHours)), 'yyyy-MM-ddTHH:00:00Z'), pipeline().parameters.modifiedBeforeUtc)",
                      "sourceFolderPath": "@pipeline().parameters.sourceFolderPath",
                      "sourceFilePattern": "@pipeline().parameters.sourceFilePattern",
                      "sourceWorkspaceResourceId": "@pipeline().parameters.sourceWorkspaceResourceId",
                      "targetFileSystem": "@pipeline().parameters.targetFileSystem",
                      "sourceContainerPrefix": "@pipeline().parameters.sourceContainerPrefix"
                    }
                  }
                }
              ]
            }
          }
        ],
        "annotations": [
          "sentinel-bcdr",
          "delta",
          "runtime-discovery"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/pipelines', parameters('dataFactoryName'), 'pl_export_container_window_delta')]"
      ]
    },
    {      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'pl_refresh_table_schemas')]",
      "properties": {
        "description": "Read the Log Analytics workspace table schema (declared column types, including dynamic) from the Azure Resource Manager Tables API and write it to the target so the export can later cast string columns back to their native types. Run daily; the export pipeline does not depend on it. Requires Reader on the workspace for the Data Factory managed identity.",
        "parameters": {
          "sourceWorkspaceResourceId": {
            "type": "String",
            "defaultValue": "[parameters('sourceWorkspaceResourceId')]"
          },
          "metadataFileSystem": {
            "type": "String",
            "defaultValue": "[parameters('metadataFileSystem')]"
          }
        },
        "activities": [
          {
            "name": "CopyWorkspaceTablesSchema",
            "type": "Copy",
            "dependsOn": [],
            "policy": {
              "timeout": "0.00:10:00",
              "retry": 2,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "source": {
                "type": "RestSource",
                "httpRequestTimeout": "00:01:40",
                "requestInterval": "00.00:00:00.010",
                "requestMethod": "GET"
              },
              "sink": {
                "type": "JsonSink",
                "storeSettings": {
                  "type": "AzureBlobFSWriteSettings"
                },
                "formatSettings": {
                  "type": "JsonWriteSettings"
                }
              },
              "enableStaging": false
            },
            "inputs": [
              {
                "referenceName": "ds_arm_workspace_tables",
                "type": "DatasetReference",
                "parameters": {
                  "workspaceResourceId": "@pipeline().parameters.sourceWorkspaceResourceId"
                }
              }
            ],
            "outputs": [
              {
                "referenceName": "ds_metadata_raw_json",
                "type": "DatasetReference",
                "parameters": {
                  "fileSystem": "@pipeline().parameters.metadataFileSystem",
                  "fileName": "workspace-tables.json"
                }
              }
            ]
          },
          {
            "name": "BuildSchemas",
            "type": "ExecuteDataFlow",
            "dependsOn": [
              {
                "activity": "CopyWorkspaceTablesSchema",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "policy": {
              "timeout": "0.00:30:00",
              "retry": 0,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "dataflow": {
                "referenceName": "df_build_schemas",
                "type": "DataFlowReference",
                "parameters": {
                  "metadataFileSystem": "'@{pipeline().parameters.metadataFileSystem}'"
                }
              },
              "integrationRuntime": {
                "referenceName": "ir-dataflow-warm",
                "type": "IntegrationRuntimeReference"
              },
              "traceLevel": "None"
            }
          }
        ],
        "annotations": [
          "sentinel-bcdr",
          "metadata"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('dataFactoryName'), 'ds_arm_workspace_tables')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('dataFactoryName'), 'ds_metadata_raw_json')]",
        "[resourceId('Microsoft.DataFactory/factories/dataflows', parameters('dataFactoryName'), 'df_build_schemas')]",
        "[resourceId('Microsoft.DataFactory/factories/integrationRuntimes', parameters('dataFactoryName'), 'ir-dataflow-warm')]"
      ]
    },
    {      "condition": "[or(parameters('enableTrigger'), not(empty(parameters('triggerStartTimeUtc'))))]",
      "type": "Microsoft.DataFactory/factories/triggers",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'tr_hourly_discover_and_export_azmon_to_delta')]",
      "properties": {
        "annotations": [
          "sentinel-bcdr",
          "delta"
        ],
        "pipelines": [
          {
            "pipelineReference": {
              "referenceName": "pl_discover_and_export_azmon_to_delta",
              "type": "PipelineReference"
            },
            "parameters": {}
          }
        ],
        "type": "ScheduleTrigger",
        "typeProperties": {
          "recurrence": {
            "frequency": "[parameters('triggerFrequency')]",
            "interval": "[parameters('triggerInterval')]",
            "startTime": "[if(empty(parameters('triggerStartTimeUtc')), '2026-01-01T00:00:00Z', parameters('triggerStartTimeUtc'))]",
            "timeZone": "UTC"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/pipelines', parameters('dataFactoryName'), 'pl_discover_and_export_azmon_to_delta')]"
      ]
    },
    {
      "condition": "[or(parameters('enableTrigger'), not(empty(parameters('triggerStartTimeUtc'))))]",
      "type": "Microsoft.DataFactory/factories/triggers",
      "apiVersion": "2018-06-01",
      "name": "[format('{0}/{1}', parameters('dataFactoryName'), 'tr_daily_refresh_table_schemas')]",
      "properties": {
        "annotations": [
          "sentinel-bcdr",
          "metadata"
        ],
        "pipelines": [
          {
            "pipelineReference": {
              "referenceName": "pl_refresh_table_schemas",
              "type": "PipelineReference"
            },
            "parameters": {}
          }
        ],
        "type": "ScheduleTrigger",
        "typeProperties": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "[if(empty(parameters('triggerStartTimeUtc')), '2026-01-01T00:00:00Z', parameters('triggerStartTimeUtc'))]",
            "timeZone": "UTC"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/pipelines', parameters('dataFactoryName'), 'pl_refresh_table_schemas')]"
      ]
    },
    {
      "condition": "[not(empty(parameters('logAnalyticsWorkspaceId')))]",
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
      "name": "send-to-log-analytics",
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "PipelineRuns",
            "enabled": true
          },
          {
            "category": "TriggerRuns",
            "enabled": true
          },
          {
            "category": "ActivityRuns",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]"
      ]
    }
  ],
  "outputs": {
    "dataFactoryResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]"
    },
    "dataFactoryPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName')), '2018-06-01', 'full').identity.principalId]"
    },
    "sourceStorageRoleRequired": {
      "type": "string",
      "value": "Grant Reader plus Storage Blob Data Reader to the Data Factory managed identity on the source storage account. Reader is needed for ARM container discovery."
    },
    "targetStorageRoleRequired": {
      "type": "string",
      "value": "Grant Storage Blob Data Contributor to the Data Factory managed identity on the target ADLS Gen2 account or file system."
    },
    "workspaceRoleRequired": {
      "type": "string",
      "value": "Grant Reader to the Data Factory managed identity on the Log Analytics workspace so the daily schema-refresh pipeline can read declared table column types from the Azure Resource Manager Tables API (metadata only). Only needed if you run pl_refresh_table_schemas."
    }
  }
}