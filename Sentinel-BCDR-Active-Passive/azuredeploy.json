              "sourceFolderPath": "[parameters('sourceWildcardFolderPath')]",
              "sourceFilePattern": "[parameters('sourceFilePattern')]",
              "targetRootPath": "[parameters('targetRootPath')]",
              "maxConcurrentContainers": "[parameters('maxConcurrentContainers')]"
            }
          }
        ],
        "type": "ScheduleTrigger",
