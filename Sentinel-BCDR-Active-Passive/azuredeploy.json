      "properties": "[union(variables('$fxv#1').properties, createObject('typeProperties', createObject('location', createObject('type', 'AzureBlobFSLocation', 'fileSystem', parameters('targetFileSystem'), 'folderPath', '@dataset().folderPath'), 'compressionCodec', 'snappy')))]",
      "dependsOn": [
