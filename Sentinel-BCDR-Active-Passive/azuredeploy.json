          },
          "compressionCodec": "snappy"
        },
        "annotations": [
          "sentinel-bcdr"
        ]
      }
    },
    "$fxv#2": {
      "name": "pl_copy_monitor_container_window",
      "properties": {
        "description": "Copy one Azure Monitor export container/window from JSON-lines to static Snappy Parquet.",
        "parameters": {
          "containerName": {
            "type": "String"
          },
          "modifiedAfterUtc": {
            "type": "String"
          },
          "modifiedBeforeUtc": {
            "type": "String"
          },
          "sourceFolderPath": {
            "type": "String",
            "defaultValue": "WorkspaceResourceId=*"
          },
          "sourceFilePattern": {
            "type": "String",
            "defaultValue": "PT5M*.json"
          },
          "targetRootPath": {
            "type": "String",
            "defaultValue": "sentinel-bcdr"
          },
          "runId": {
            "type": "String",
            "defaultValue": "@pipeline().RunId"
          }
        },
        "activities": [
          {
            "name": "CopyJsonLinesToParquet",
            "type": "Copy",
            "dependsOn": [],
            "policy": {
              "timeout": "7.00:00:00",
              "retry": 2,
              "retryIntervalInSeconds": 120,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "source": {
                "type": "JsonSource",
                "storeSettings": {
                  "type": "AzureBlobStorageReadSettings",
                  "recursive": true,
                  "wildcardFolderPath": "@pipeline().parameters.sourceFolderPath",
                  "wildcardFileName": "@pipeline().parameters.sourceFilePattern",
                  "modifiedDatetimeStart": "@pipeline().parameters.modifiedAfterUtc",
                  "modifiedDatetimeEnd": "@pipeline().parameters.modifiedBeforeUtc"
                },
                "formatSettings": {
                  "type": "JsonReadSettings"
                },
                "additionalColumns": [
                  {
                    "name": "_SourceContainer",
                    "value": "@pipeline().parameters.containerName"
                  },
                  {
                    "name": "_AdfPipelineRunId",
                    "value": "@pipeline().RunId"
                  },
                  {
                    "name": "_ProcessedUtc",
                    "value": "@utcNow()"
                  }
                ]
              },
              "sink": {
                "type": "ParquetSink",
                "storeSettings": {
                  "type": "AzureBlobFSWriteSettings"
                },
                "formatSettings": {
                  "type": "ParquetWriteSettings"
                }
              },
              "enableStaging": false,
              "translator": {
                "type": "TabularTranslator"
              }
            },
            "inputs": [
              {
                "referenceName": "ds_source_monitor_json_lines",
                "type": "DatasetReference",
                "parameters": {
                  "containerName": "@pipeline().parameters.containerName"
                }
              }
            ],
            "outputs": [
              {
                "referenceName": "ds_target_static_parquet",
                "type": "DatasetReference",
                "parameters": {
                  "folderPath": "@concat(pipeline().parameters.targetRootPath, '/table=', pipeline().parameters.containerName, '/year=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'yyyy'), '/month=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'MM'), '/day=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'dd'), '/hour=', formatDateTime(pipeline().parameters.modifiedAfterUtc, 'HH'), '/batch=', pipeline().parameters.runId)"
                }
              }
            ]
          }
        ],
        "annotations": [
          "sentinel-bcdr",
          "static-parquet"
        ]
      }
    },
    "$fxv#3": {
      "name": "pl_discover_and_export_azmon_to_parquet",
      "properties": {
        "description": "Discover matching Azure Monitor export containers through Azure Resource Manager and export the previous processing window to static Snappy Parquet.",
        "parameters": {
          "sourceStorageAccountResourceId": {
            "type": "String"
          },
          "sourceContainerPrefix": {
            "type": "String",
            "defaultValue": "am-"
          },
          "processingDelayHours": {
            "type": "Int",
            "defaultValue": 1
          },
          "modifiedAfterUtc": {
            "type": "String",
            "defaultValue": ""
          },
          "modifiedBeforeUtc": {
            "type": "String",
            "defaultValue": ""
          },
          "sourceFolderPath": {
            "type": "String",
            "defaultValue": "WorkspaceResourceId=*"
          },
          "sourceFilePattern": {
            "type": "String",
            "defaultValue": "PT5M*.json"
          },
          "targetRootPath": {
            "type": "String",
            "defaultValue": "sentinel-bcdr"
          },
          "maxConcurrentContainers": {
            "type": "Int",
            "defaultValue": 8
          }
        },
        "activities": [
          {
            "name": "ListSourceContainers",
            "type": "WebActivity",
            "dependsOn": [],
            "policy": {
              "timeout": "0.00:02:00",
              "retry": 2,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "method": "GET",
              "url": "@concat('https://management.azure.com', pipeline().parameters.sourceStorageAccountResourceId, '/blobServices/default/containers?api-version=2023-01-01')",
              "authentication": {
                "type": "MSI",
                "resource": "https://management.azure.com/"
              }
            }
          },
          {
            "name": "FilterMatchingContainers",
            "type": "Filter",
            "dependsOn": [
              {
                "activity": "ListSourceContainers",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "items": "@activity('ListSourceContainers').output.value",
              "condition": "@startswith(item().name, pipeline().parameters.sourceContainerPrefix)"
            }
          },
          {
            "name": "ForEachMatchingContainer",
            "type": "ForEach",
            "dependsOn": [
              {
                "activity": "FilterMatchingContainers",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "items": "@activity('FilterMatchingContainers').output.value",
              "isSequential": false,
              "batchCount": 8,
              "activities": [
                {
                  "name": "CopyContainerWindow",
                  "type": "ExecutePipeline",
                  "dependsOn": [],
                  "typeProperties": {
                    "pipeline": {
                      "referenceName": "pl_copy_monitor_container_window",
                      "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                      "containerName": "@item().name",
                      "modifiedAfterUtc": "@if(equals(pipeline().parameters.modifiedAfterUtc, ''), formatDateTime(addHours(utcNow(), mul(-1, add(pipeline().parameters.processingDelayHours, 1))), 'yyyy-MM-ddTHH:00:00Z'), pipeline().parameters.modifiedAfterUtc)",
                      "modifiedBeforeUtc": "@if(equals(pipeline().parameters.modifiedBeforeUtc, ''), formatDateTime(addHours(utcNow(), mul(-1, pipeline().parameters.processingDelayHours)), 'yyyy-MM-ddTHH:00:00Z'), pipeline().parameters.modifiedBeforeUtc)",
                      "sourceFolderPath": "@pipeline().parameters.sourceFolderPath",
                      "sourceFilePattern": "@pipeline().parameters.sourceFilePattern",
                      "targetRootPath": "@pipeline().parameters.targetRootPath",
                      "runId": "@pipeline().RunId"
                    }
                  }
                }
              ]
            }
          }
        ],
        "annotations": [
          "sentinel-bcdr",
          "runtime-discovery"
        ]
      }
    }
  },
