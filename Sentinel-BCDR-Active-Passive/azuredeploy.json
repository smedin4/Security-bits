      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "UTC schedule start time. Leave empty to skip trigger creation until parameters are finalized."
      }
    },
    "processingDelayHours": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 0,
      "metadata": {
        "description": "Hours to wait before processing. The default processes the previous complete hour."
      }
    },
    "tableAllowList": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional comma-separated list of source container names to process. Leave empty to process all containers matching sourceContainerPrefix. Use this to test the pipeline on a small subset of tables before running it for everything, for example am-signinlogs,am-microsoftgraphactivitylogs."
      }
    },
    "enableTrigger": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set to true to create and start the hourly schedule trigger. Leave false to deploy without a schedule so you can run the pipeline manually (recommended while testing with tableAllowList)."
      }
    },
    "dataFlowCoreCount": {
      "type": "int",
      "defaultValue": 8,
      "allowedValues": [
        8,
        16,
        32,
        48,
        80,
        144,
        272
      ],
      "metadata": {
        "description": "Spark core count for the warm data flow Integration Runtime. 8 is the cheapest; 16 is the Microsoft-recommended minimum for production workloads."
      }
    },
    "dataFlowTimeToLiveMinutes": {
