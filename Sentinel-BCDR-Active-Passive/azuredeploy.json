      }
    },
    "sourceWorkspaceResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. The exact value Azure Monitor writes after WorkspaceResourceId= in the source blob path: the Log Analytics workspace ARM ID, lowercased, beginning with /subscriptions/. When set, the copy and delta sources list only the processed hour folder instead of the whole container, which keeps source listing fast as history grows. Leave empty to scan the whole container with sourceWildcardFolderPath. Assumes a single workspace per source container; the casing must match the storage browser exactly."
      }
    },
    "sourceFilePattern": {
